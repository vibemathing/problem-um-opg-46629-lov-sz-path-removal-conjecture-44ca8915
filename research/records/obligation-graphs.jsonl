{"attempt_id": "attempt:um-opg-46629-lov-sz-path-removal-conjecture-44ca8915-source-fidelity-01", "created_at": "2026-09-06T08:00:00Z", "graph_id": "graph:um-opg-46629-lov-sz-path-removal-conjecture-44ca8915-v1", "obligations": [{"acceptance": {"allowed_candidate_kinds": ["proof", "counterexample", "formalization", "computation"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": ["obligation:um-opg-46629-lov-sz-path-removal-conjecture-44ca8915-statement-fidelity"], "kind": "root_claim", "obligation_id": "obligation:um-opg-46629-lov-sz-path-removal-conjecture-44ca8915-root", "source_refs": ["https://www.unsolvedmath.com/problems/OPG-46629"], "statement": {"formal_declaration": null, "language": "en", "text": "Conjecture There is an integer-valued function $f(k)$ such that if $G$ is any $f(k)$-connected graph and $x$ and $y$ are any two vertices of $G$, then there exists an induced path $P$ with ends $x$ and $y$ such that $G-V(P)$ is $k$-connected."}, "statement_sha256": "1d6c5397b09d44b40d6d5b9d950285cefa694a1369500e562f6a2cef6842d63f"}, {"acceptance": {"allowed_candidate_kinds": ["proof"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": [], "kind": "definition", "obligation_id": "obligation:um-opg-46629-lov-sz-path-removal-conjecture-44ca8915-statement-fidelity", "source_refs": ["https://www.unsolvedmath.com/problems/OPG-46629"], "statement": {"formal_declaration": null, "language": "en", "text": "Verify against the cited source that the frozen statement is complete, current, untruncated, attribution-correct, and unambiguous enough for mathematical research; record any definition or quantifier gap without silently editing the contract."}, "statement_sha256": "65f0b3d574bd6d837403149dab6434c0f571709f7eb5bb066c7e8774bad13f34"}], "problem_contract_sha256": "c1850f994e0f728237bd3e6b1aa47310614eed168ef531e3564e67e8309881ef", "problem_id": "problem:um-opg-46629-lov-sz-path-removal-conjecture-44ca89